{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "celld-docs-cn",
  "account_id": "df8e52f84e64a4ca5a6b85c646f8013a",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "celld.genhub.me", "custom_domain": true }
  ]
}
